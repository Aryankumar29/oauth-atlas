# Copy to .env.local (never commit). Names only — no values.
# LLM provider: gemini (default) | anthropic | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (check the provider's current model list)
LLM_MODEL=
# Upstash Redis / Vercel KV (map KV_REST_API_* to these if the Vercel integration uses those names)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 1 = offline mode: mock LLM + recorded HTTP fixtures + memory store (no keys needed)
MOCK_LLM=
# Optional
JINA_API_KEY=
COMPOSIO_API_KEY=
