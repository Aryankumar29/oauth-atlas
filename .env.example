# Copy to .env.local (never commit). Names only — no values.
# On Vercel, the human sets these in Project Settings -> Environment Variables.

# 1 = offline mode: mock LLM + recorded HTTP fixtures + memory store (no keys needed)
MOCK_LLM=

# LLM provider: anthropic (default; Claude with server-side web search) | gemini | openai. Optional.
LLM_PROVIDER=
# Optional model override. Code defaults: claude-opus-5-5, gemini-2.5-flash, gpt-5-mini
LLM_MODEL=
# Key for the selected provider (only that one is required). Default provider needs ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible v1 API, e.g. Azure OpenAI https://<resource>.openai.azure.com/openai/v1 (LLM_MODEL = deployment name)
OPENAI_BASE_URL=

# Upstash Redis: runs, guide:{slug} cache, rate limit. Unset = in-memory store (nothing persists).
# lib/store.ts also reads KV_REST_API_URL / KV_REST_API_TOKEN (Vercel's Upstash integration names).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# Public URL of this deployment, used for links in /api/guides responses (on Vercel the production domain is used automatically)
NEXT_PUBLIC_SITE_URL=
# Jina Reader fallback (r.jina.ai) for docs that block plain fetches; the key is optional
JINA_API_KEY=
# Composio toolkit API; without it the live managed-auth page, then data/composio-managed.json, is used
COMPOSIO_API_KEY=
# Comma-separated slugs served from the demo cache; code default is miro,calendly
DEMO_CACHE_SLUGS=
# 0 = disable the Jina Reader fallback
READER_FALLBACK=
