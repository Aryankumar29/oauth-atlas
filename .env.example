# Copy to .env.local (never commit). Names only — no values.
# On Vercel, the human sets these in Project Settings -> Environment Variables.

# 1 = offline mode: mock LLM + recorded HTTP fixtures + memory store (no keys needed)
MOCK_LLM=

# LLM provider: gemini (default, with Google Search grounding) | anthropic | openai
LLM_PROVIDER=
# Optional model override. Code defaults: gemini-2.5-flash, claude-sonnet-5-5, gpt-5-mini
LLM_MODEL=
# Key for the selected provider (only that one is required)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Upstash Redis: runs, guide:{slug} cache, rate limit. Unset = in-memory store (nothing persists).
# lib/store.ts also reads KV_REST_API_URL / KV_REST_API_TOKEN (Vercel's Upstash integration names).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# Jina Reader fallback (r.jina.ai) for docs that block plain fetches; the key is optional
JINA_API_KEY=
# Composio toolkit API; without it the live managed-auth page, then data/composio-managed.json, is used
COMPOSIO_API_KEY=
# Comma-separated slugs served from the demo cache; code default is miro,calendly
DEMO_CACHE_SLUGS=
# 0 = disable the Jina Reader fallback
READER_FALLBACK=
