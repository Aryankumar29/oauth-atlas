# Copy to .env.local and fill in. Never commit .env.local.

# LLM provider — use one
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Web search for live generation
TAVILY_API_KEY=
# Alternative: BRAVE_SEARCH_API_KEY=

# Public URL used for share links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional persistence (JSON files are enough for v0)
DATABASE_URL=
